# Copy to .env for local development. Existing process variables take priority.
# Values support ${VAR} expansion; only VITE_* variables enter browser bundles.
# Supply production/container variables through the hosting platform.

# https://vite.dev/guide/env-and-mode

# Set false for an SPA build. Read by Router config for dev/build; production reads the build mode.
# SSR=false

# API origin for separately hosted static clients; allow the client origin in server ALLOWED_ORIGINS.
# VITE_API_ORIGIN=https://api.example.com

# Production listener address. Development uses the Vite listener.
# HOST=0.0.0.0
# Production listener port. Development uses the Vite port.
# PORT=3000

# Enable only behind a trusted TLS proxy setting X-Forwarded-Proto and, when needed, X-Forwarded-Host.
# TRUST_PROXY=true

# Server: trace/debug/info/warn/error/fatal/silent; default debug in development, silent in tests, warn otherwise. Desktop main accepts debug/info (default info).
# LOG_LEVEL=info

# Development host selection; production entries supply createWebApp({ shell }).
# WEB_SHELL=desktop
# Desktop platform: darwin, win32 or linux; invalid values fall back to web.
# WEB_SHELL_PLATFORM=darwin
# OS version supplied by the desktop development runner.
# WEB_SHELL_OS_VERSION=26.1
# Linux XDG_CURRENT_DESKTOP session hint.
# WEB_SHELL_DESKTOP_ENV=GNOME
# Linux XDG_SESSION_TYPE session hint.
# WEB_SHELL_SESSION_TYPE=wayland

# Optional visual preference cookie mirror. Compile both server/client with the same value.
# Disabled by default; ignored for Electron documents. Rebuild when changing this flag.
VITE_VISUAL_COOKIE=false
