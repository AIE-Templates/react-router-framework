{
  "name": "desktop",
  "version": "0.1.0",
  "private": true,
  "description": "The desktop shell: Electron hosting the web app's server build in a utility process",
  "homepage": "https://example.com",
  "author": {
    "name": "Example",
    "email": "desktop@example.com"
  },
  "type": "module",
  "main": ".vite/build/main.cjs",
  "scripts": {
    "bench": "node scripts/bench.ts",
    "build": "vite build --config vite.main.config.ts && vite build --config vite.preload.config.ts && vite build --config vite.utility.config.ts",
    "dev": "node scripts/dev.ts",
    "dist": "electron-builder",
    "dist:release": "electron-builder --config electron-builder.release.yml",
    "package": "electron-builder --dir",
    "package:release": "electron-builder --dir --config electron-builder.release.yml",
    "start": "electron .",
    "test:e2e": "playwright test",
    "typecheck": "tsc"
  },
  "dependencies": {},
  "devDependencies": {
    "@electron/fuses": "^2.1.3",
    "@playwright/test": "^1.64.1",
    "@repo/port-fetch": "workspace:*",
    "@repo/server": "workspace:*",
    "@repo/shared": "workspace:*",
    "electron": "45.0.0",
    "electron-builder": "^26.18.0",
    "hono": "^4.13.13",
    "vite": "^8.3.5",
    "web": "workspace:*"
  }
}
