{
  "name": "desktop",
  "version": "0.1.0",
  "private": true,
  "description": "The desktop shell: Electron hosting the web app's server build in a utility process",
  "homepage": "https://example.com",
  "author": {
    "name": "Example",
    "email": "desktop@example.com"
  },
  "type": "module",
  "main": ".vite/test/main.cjs",
  "scripts": {
    "bench": "node scripts/bench.ts",
    "build": "node scripts/build.ts",
    "dev": "node scripts/dev.ts",
    "dist:release": "node scripts/check-web-build.ts release && electron-builder --config electron-builder.release.yml",
    "package": "node scripts/check-web-build.ts test && electron-builder --dir --config electron-builder.test.yml",
    "package:release": "node scripts/check-web-build.ts release && electron-builder --dir --config electron-builder.release.yml",
    "start": "node scripts/start.ts",
    "test:e2e": "playwright test",
    "test:e2e:demo": "playwright test --grep @demo",
    "test:e2e:host": "playwright test --grep-invert @demo",
    "typecheck": "tsc",
    "verify:build": "node scripts/verify-build.ts"
  },
  "dependencies": {},
  "devDependencies": {
    "@electron/fuses": "^2.1.3",
    "@playwright/test": "^1.64.1",
    "@repo/port-fetch": "workspace:*",
    "@repo/server": "workspace:*",
    "@repo/shared": "workspace:*",
    "electron": "45.0.0",
    "electron-builder": "^26.18.0",
    "hono": "^4.13.13",
    "vite": "^8.3.5",
    "web": "workspace:*"
  },
  "productName": "Desktop"
}
