# Desktop options come from the process environment; the host does not load .env.
# dev:desktop supplies WEB_SHELL* to its web development server.

# Run self-checks after the first page, print SMOKE_RESULT and exit 0/1.
# DESKTOP_SMOKE=1
# With DESKTOP_SMOKE=1, save a window PNG before exit.
# DESKTOP_SMOKE_SCREENSHOT=/tmp/desktop.png
# Print BOOT_PROFILE startup stage durations in milliseconds.
# DESKTOP_BOOT_PROFILE=1
# Real-app benchmarks, unpackaged/test-profile only; ignored by release-profile and dev server.
# DESKTOP_BENCH=1
# Benchmark measurement duration in milliseconds; default 5000.
# DESKTOP_BENCH_MEASURE_MS=5000
# Benchmark warmup duration in milliseconds; default 1000.
# DESKTOP_BENCH_WARMUP_MS=1000
# Comma-separated benchmark case subset.
# DESKTOP_BENCH_CASES=api-c1,download-4m
# Free-text label stored with benchmark results.
# DESKTOP_BENCH_LABEL=
# Set 0 to disable port-fetch ACK batching on both ends; 1/unset enables the default.
# DESKTOP_PORT_ACK_COALESCE=1
# Playwright test endpoints; unavailable in release-profile even when this flag is set.
# DESKTOP_E2E=1
# Benchmark runner only: forward Chromium stderr.
# BENCH_VERBOSE=1
# Isolate user data as <userData>-<suffix>; development uses dev.
# DESKTOP_USER_DATA_SUFFIX=dev
# Server: trace/debug/info/warn/error/fatal/silent; default debug in development, silent in tests, warn otherwise. Desktop main accepts debug/info (default info).
# LOG_LEVEL=info

# Desktop Router development server port; default 5174.
# DESKTOP_DEV_PORT=5174

# native-overlay is default; system-decorated is explicit; custom-controls falls back to system-decorated.
# DESKTOP_CHROME_MODE=system-decorated
