{
  "name": "@repo/electron-cookies",
  "private": true,
  "files": [
    "dist",
    "!dist/e2e",
    "src",
    "!src/**/*.test.ts",
    "!src/testing"
  ],
  "type": "module",
  "exports": {
    "./main": {
      "@repo/source": "./src/main.ts",
      "types": "./dist/main.d.ts",
      "default": "./dist/main.js"
    },
    "./preload": {
      "@repo/source": "./src/preload/index.ts",
      "types": "./dist/preload/index.d.ts",
      "default": "./dist/preload/index.js"
    },
    "./shared": {
      "@repo/source": "./src/shared.ts",
      "types": "./dist/shared.d.ts",
      "default": "./dist/shared.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "build:e2e": "tsc -p tsconfig.e2e.json",
    "test:e2e": "pnpm build:e2e && playwright test",
    "typecheck": "tsc"
  },
  "devDependencies": {
    "@babel/parser": "^7.29.11",
    "@babel/types": "^7.29.11",
    "@playwright/test": "^1.64.1",
    "electron": "45.0.0"
  },
  "peerDependencies": {
    "electron": "^45.0.0"
  }
}
